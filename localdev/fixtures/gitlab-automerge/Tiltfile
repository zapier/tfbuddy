# -*- mode: Python -*-
load('ext://configmap', 'configmap_from_dict')
load('ext://dotenv', 'dotenv')
load('ext://list_port_forwards', 'display_port_forwards')
load('ext://namespace', 'namespace_yaml')
load('ext://restart_process', 'docker_build_with_restart')
load('ext://secret', 'secret_from_dict')

dotenv('../../../.env')

# Keep these definitions compatible with the repository's tilt_config.json.
config.define_bool('enable_gitlab')
config.define_bool('enable_github')
config.define_bool('live_debug')
config.define_string('ngrok_fqdn')
cfg = config.parse()

allow_k8s_contexts([
  'kind-kind',
  'docker-desktop',
  'minikube',
])

def check_env_set(key):
  if not os.getenv(key):
    fail('{} not set'.format(key))

def get_ngrok_url(cfg):
  if cfg.get('ngrok_fqdn'):
    return 'https://' + cfg.get('ngrok_fqdn')
  if config.tilt_subcommand == 'down':
    local('rm ngrok.url || true')
    return 'http://xyz.ngrok.io'
  return str(read_file('ngrok.url', '')).rstrip('\n')

def deploy_ngrok(cfg):
  hostname_arg = ''
  if cfg.get('ngrok_fqdn'):
    hostname_arg = ' --hostname {}'.format(cfg.get('ngrok_fqdn'))
  local_resource(
    'ngrok',
    serve_cmd='ngrok http localhost:8080 {}'.format(hostname_arg),
    readiness_probe=probe(
      initial_delay_secs=5,
      period_secs=10,
      exec=exec_action([
        'bash',
        '-c',
        'cd localdev/fixtures/gitlab-automerge && ../../ngrok/update-url.sh',
      ]),
    ),
    labels=['ngrok'],
    links=['http://localhost:4040'],
  )

def local_terraform_fixture(name, dir, env, deps, resource_deps):
  local(
    'terraform -chdir={} init -upgrade'.format(dir),
    env=env,
    quiet=True,
    echo_off=True,
  )

  show = decode_json(local(
    'terraform -chdir={} show -json'.format(dir),
    env=env,
    quiet=True,
    echo_off=True,
  ))
  outputs = {}
  if 'values' in show and 'outputs' in show['values']:
    for key, value in show['values']['outputs'].items():
      outputs[key] = value['value']

  if config.tilt_subcommand == 'down':
    local(
      'terraform -chdir={} destroy -auto-approve -var enable_webhooks=true'.format(dir),
      env=env,
    )
    local_resource(name, 'true')
    return outputs

  local_resource(
    '{}-base'.format(name),
    'terraform -chdir={} apply -auto-approve -var enable_webhooks=false'.format(dir),
    env=env,
    deps=deps,
    labels=['fixture'],
    resource_deps=resource_deps,
  )
  return outputs

check_env_set('TFC_ORGANIZATION')
check_env_set('TFC_TOKEN')
check_env_set('GITLAB_TOKEN')
check_env_set('TFBUDDY_HOOK_SECRET')

k8s_namespace = 'tfbuddy-automerge'
k8s_yaml(namespace_yaml(k8s_namespace), allow_duplicates=False)
k8s_resource(
  objects=['{}:namespace'.format(k8s_namespace)],
  labels=['localdev'],
  new_name='k8s:namespace',
)

deploy_ngrok(cfg)
ngrok_url = get_ngrok_url(cfg)

fixture_outputs = local_terraform_fixture(
  'tf-gitlab-automerge',
  dir='./terraform',
  env={
    'GITLAB_TOKEN': os.getenv('GITLAB_TOKEN'),
    'TFC_TOKEN': os.getenv('TFC_TOKEN'),
    'TF_VAR_ngrok_url': ngrok_url,
    'TF_VAR_tfc_organization': os.getenv('TFC_ORGANIZATION'),
    'TF_VAR_tfbuddy_gitlab_hook_secret_key': os.getenv('TFBUDDY_HOOK_SECRET'),
  },
  deps=[
    './terraform/*.tf',
  ],
  resource_deps=['ngrok'],
)

if 'gitlab_project_url' in fixture_outputs:
  fixture_links = [
    link(fixture_outputs['gitlab_project_url'], 'GitLab project'),
  ]
  for index, workspace_url in enumerate(fixture_outputs.get('tfc_workspace_urls', [])):
    fixture_links.append(link(workspace_url, 'TFC workspace {}'.format(index + 1)))
  local_resource(
    'fixture-links',
    'true',
    links=fixture_links,
    labels=['fixture'],
    resource_deps=['tf-gitlab-automerge-base'],
  )

k8s_yaml(helm(
  '../../nats/chart/nats',
  name='nats',
  namespace=k8s_namespace,
  values='../../nats/values.yaml',
))
k8s_resource(
  'nats',
  objects=[
    'nats:poddisruptionbudget',
    'nats-config:configmap',
    'nats:serviceaccount',
  ],
  labels=['nats'],
  resource_deps=['k8s:namespace'],
  port_forwards=['4222'],
)
k8s_resource(
  'nats-box',
  labels=['nats'],
  resource_deps=['k8s:namespace'],
)

arch = 'arm64' if str(local('uname -m')).strip('\n') == 'arm64' else 'amd64'
build_cmd = 'CGO_ENABLED=0 GOOS=linux GOARCH={} go build -gcflags="all=-N -l" -o build/tfbuddy ./'.format(arch)
local_resource(
  'go-build',
  build_cmd,
  dir='../../..',
  deps=[
    '../../../main.go',
    '../../../go.mod',
    '../../../go.sum',
    '../../../cmd',
    '../../../internal',
    '../../../pkg',
  ],
  labels=['tfbuddy'],
)

if cfg.get('live_debug'):
  docker_build_with_restart(
    'tfbuddy-server',
    '../../..',
    dockerfile='../../../localdev/Dockerfile.dlv',
    entrypoint='$GOPATH/bin/dlv --listen=:2345 --api-version=2 --headless=true --accept-multiclient exec --continue /app/tfbuddy tfc handler',
    ignore=['./Dockerfile', '.git'],
    only=['./build'],
    live_update=[sync('./build/tfbuddy', '/app/tfbuddy')],
  )
else:
  docker_build(
    'tfbuddy-server',
    '../../..',
    dockerfile='../../../localdev/Dockerfile',
    only=['./build'],
  )

workspace_allow_list = ''
project_allow_list = ''
if 'tfc_workspaces' in fixture_outputs:
  workspace_allow_list = ','.join(fixture_outputs['tfc_workspaces'])
if 'gitlab_project_name' in fixture_outputs:
  project_allow_list = fixture_outputs['gitlab_project_name']

k8s_yaml(configmap_from_dict('tfbuddy-config', namespace=k8s_namespace, inputs={
  'TFBUDDY_LOG_LEVEL': 'debug',
  'TFBUDDY_DEFAULT_TFC_ORGANIZATION': os.getenv('TFC_ORGANIZATION'),
  'TFBUDDY_WORKSPACE_ALLOW_LIST': workspace_allow_list,
  'TFBUDDY_GITLAB_PROJECT_ALLOW_LIST': project_allow_list,
}))
k8s_resource(
  objects=['tfbuddy-config:configmap'],
  labels=['tfbuddy'],
  new_name='tfbuddy-config',
  resource_deps=['tf-gitlab-automerge-base'],
)

k8s_yaml(secret_from_dict('tfbuddy-secrets', namespace=k8s_namespace, inputs={
  'GITLAB_TOKEN': os.getenv('GITLAB_TOKEN'),
  'TFC_TOKEN': os.getenv('TFC_TOKEN'),
  'TFBUDDY_GITLAB_HOOK_SECRET_KEY': os.getenv('TFBUDDY_HOOK_SECRET'),
}))
k8s_resource(
  objects=['tfbuddy-secrets:secret'],
  labels=['tfbuddy'],
  new_name='tfbuddy-secrets',
)

k8s_yaml(kustomize('./manifests'))
k8s_resource(
  'tfbuddy',
  port_forwards=[2345, 8080],
  resource_deps=[
    'go-build',
    'nats',
    'tfbuddy-config',
    'tfbuddy-secrets',
  ],
  labels=['tfbuddy'],
)

local_resource(
  'tf-gitlab-automerge-webhooks',
  'terraform -chdir=./terraform apply -auto-approve -var enable_webhooks=true',
  env={
    'GITLAB_TOKEN': os.getenv('GITLAB_TOKEN'),
    'TFC_TOKEN': os.getenv('TFC_TOKEN'),
    'TF_VAR_ngrok_url': ngrok_url,
    'TF_VAR_tfc_organization': os.getenv('TFC_ORGANIZATION'),
    'TF_VAR_tfbuddy_gitlab_hook_secret_key': os.getenv('TFBUDDY_HOOK_SECRET'),
  },
  deps=['./terraform/*.tf'],
  labels=['fixture'],
  resource_deps=['tfbuddy', 'tf-gitlab-automerge-base'],
)

if 'delayed_workspace_name' in fixture_outputs:
  delayed_workspace_name = fixture_outputs['delayed_workspace_name']
  delayed_workspace_env = {
    'TFC_TOKEN': os.getenv('TFC_TOKEN'),
    'TF_VAR_ngrok_url': ngrok_url,
    'TF_VAR_tfc_organization': os.getenv('TFC_ORGANIZATION'),
    'TF_VAR_workspace_name': delayed_workspace_name,
  }
  local(
    'terraform -chdir=./terraform/delayed-workspace init -upgrade',
    env=delayed_workspace_env,
    quiet=True,
    echo_off=True,
  )
  if config.tilt_subcommand == 'down':
    local(
      'terraform -chdir=./terraform/delayed-workspace destroy -auto-approve',
      env=delayed_workspace_env,
    )
  else:
    local_resource(
      'tf-create-delayed-workspace',
      'terraform -chdir=./terraform/delayed-workspace apply -auto-approve',
      env=delayed_workspace_env,
      labels=['fixture'],
      links=[
        link(
          'https://app.terraform.io/app/{}/workspaces/{}'.format(
            os.getenv('TFC_ORGANIZATION'),
            delayed_workspace_name,
          ),
          'Delayed TFC workspace',
        ),
      ],
      resource_deps=['tf-gitlab-automerge-webhooks'],
      trigger_mode=TRIGGER_MODE_MANUAL,
      auto_init=False,
    )

display_port_forwards()
